  <vhdl appearance="logisim_evolution" name="rs_latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- RS latch : two cross-coupled NOR gates&#13;
entity rs_latch is&#13;
    port(&#13;
        s, r  : in  std_logic;&#13;
        q, qn : out std_logic&#13;
    );&#13;
end entity rs_latch;&#13;
&#13;
architecture bhv of rs_latch is&#13;
    signal q_i  : std_logic := '0';&#13;
    signal qn_i : std_logic := '1';&#13;
begin&#13;
    q_i  &lt;= r nor qn_i;   -- upper NOR : Q  = (R + Q')'&#13;
    qn_i &lt;= s nor q_i;    -- lower NOR : Q' = (S + Q)'&#13;
&#13;
    q  &lt;= q_i;&#13;
    qn &lt;= qn_i;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- D latch with enable (level triggered)&#13;
entity d_latch is&#13;
    port(&#13;
        d, en : in  std_logic;&#13;
        q, qn : out std_logic&#13;
    );&#13;
end entity d_latch;&#13;
&#13;
architecture bhv of d_latch is&#13;
    signal q_i : std_logic := '0';&#13;
begin&#13;
    process(d, en)&#13;
    begin&#13;
        if en = '1' then&#13;
            q_i &lt;= d;        -- en=1 : transparent, Q follows D&#13;
        end if;              -- en=0 : no assignment -&gt; keeps old value&#13;
    end process;&#13;
&#13;
    q  &lt;= q_i;&#13;
    qn &lt;= not q_i;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- Positive-edge-triggered D flip-flop&#13;
entity d_ff is&#13;
    port(&#13;
        d, clk : in  std_logic;&#13;
        q, qn  : out std_logic&#13;
    );&#13;
end entity d_ff;&#13;
&#13;
architecture bhv of d_ff is&#13;
    signal q_i : std_logic := '0';&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then   -- only at the 0 -&gt; 1 moment of clk&#13;
            q_i &lt;= d;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q  &lt;= q_i;&#13;
    qn &lt;= not q_i;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="jk_ff">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- Positive-edge-triggered JK flip-flop&#13;
--   JK = 00 Hold, 01 Reset, 10 Set, 11 Toggle&#13;
entity jk_ff is&#13;
    port(&#13;
        j, k, clk : in  std_logic;&#13;
        q, qn     : out std_logic&#13;
    );&#13;
end entity jk_ff;&#13;
&#13;
architecture bhv of jk_ff is&#13;
    signal q_i : std_logic := '0';&#13;
    signal jk  : std_logic_vector(1 downto 0);&#13;
begin&#13;
    jk &lt;= j &amp; k;               -- combine J and K into 2 bits&#13;
&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then&#13;
            case jk is&#13;
                when "00"   =&gt; q_i &lt;= q_i;       -- Hold&#13;
                when "01"   =&gt; q_i &lt;= '0';       -- Reset&#13;
                when "10"   =&gt; q_i &lt;= '1';       -- Set&#13;
                when "11"   =&gt; q_i &lt;= not q_i;   -- Toggle&#13;
                when others =&gt; q_i &lt;= q_i;&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q  &lt;= q_i;&#13;
    qn &lt;= not q_i;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff_sc">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- Positive-edge D flip-flop with asynchronous set / clear&#13;
--   clr = '1'             : Q &lt;= '0' immediately (highest priority)&#13;
--   set = '1' (clr = '0') : Q &lt;= '1' immediately&#13;
--   otherwise             : normal D flip-flop&#13;
entity d_ff_sc is&#13;
    port(&#13;
        d, clk   : in  std_logic;&#13;
        set, clr : in  std_logic;&#13;
        q, qn    : out std_logic&#13;
    );&#13;
end entity d_ff_sc;&#13;
&#13;
architecture bhv of d_ff_sc is&#13;
    signal q_i : std_logic := '0';&#13;
begin&#13;
    process(clk, set, clr)&#13;
    begin&#13;
        if clr = '1' then              -- checked first -&gt; clear has priority&#13;
            q_i &lt;= '0';&#13;
        elsif set = '1' then&#13;
            q_i &lt;= '1';&#13;
        elsif rising_edge(clk) then&#13;
            q_i &lt;= d;&#13;
        end if;&#13;
    end process;&#13;
&#13;
    q  &lt;= q_i;&#13;
    qn &lt;= not q_i;&#13;
end architecture bhv;&#13;
</vhdl>
</project>
